{
  "version": 2,
  "name": "huduma-smart",
  "functions": {
    "api/helb/login.js": { "maxDuration": 60 },
    "api/helb/otp.js":   { "maxDuration": 30 },
    "api/health.js":     { "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/app\\.js",    "dest": "/app.js"    },
    { "src": "/style\\.css", "dest": "/style.css" },
    { "src": "/(.*)",        "dest": "/index.html" }
  ]
}
